{
    "manifest_version": 3,
    "name": "Mail Attachment Holder",
    "version": "1.0",
    "description": "A simple mail Chrome extension.",
    "permissions": [
      "identity", "tabs", 
      "storage", "notifications",
      "https://googleapis.com/*",
      "identity.email"
    ],
    "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://mail.yahoo.com/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": "icon.png"
    },
    "icons": {
      "48": "icon.png"
    },
    "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://mail.yahoo.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "oauth2": {
    "client_id": "235811497805-8qbddeqbnhbuslqsaelgeaka2j19fegn.apps.googleusercontent.com.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  }
}