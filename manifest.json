{
    "manifest_version": 3,
    "name": "Mail Attachments Cabinet",
    "version": "1.0",
    "description": "A simple mail Chrome extension.",
    "permissions": [
      "scripting",
      "identity", "activeTab", 
      "storage", "notifications",
      "identity.email",
      "https://www.googleapis.com/"
    ],
    "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://mail.yahoo.com/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup/popup.html",
      "default_icon": "images/icon-48.png"
    },
    "icons": {
    "48": "images/icon-48.png"
  },
    "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://mail.yahoo.com/*"
      ],
      "js": ["scripts/content.js"]
    }
  ],
  "oauth2": {
    "client_id": "235811497805-8qbddeqbnhbuslqsaelgeaka2j19fegn.apps.googleusercontent.com.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  }
}