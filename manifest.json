{
    "manifest_version": 3,
    "name": "Q-Ttachments",
    "version": "1.0",
    "description": "Quick Download, View and Organize Attachments from your inbox",
    "permissions": [
      "identity", 
      "storage", "notifications",
      "identity.email"
    ],
    "host_permissions": [
    "https://www.googleapis.com/*",
    "https://mail.google.com/*"

    ],
    "action": {
      "default_popup": "popup/popup.html",
      "default_icon": "images/just_logo.png"
    },
    "icons": {
    "48": "images/just_logo.png"
  },
  "oauth2": {
    "client_id": "235811497805-8qbddeqbnhbuslqsaelgeaka2j19fegn",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  }
}